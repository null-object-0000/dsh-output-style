{
  "name": "dsh-output-style",
  "version": "0.1.2",
  "description": "Single-select answer modes for DeepSeek Harness.",
  "author": "null-object-0000",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/null-object-0000/dsh-output-style.git"
  },
  "homepage": "https://github.com/null-object-0000/dsh-output-style",
  "bugs": {
    "url": "https://github.com/null-object-0000/dsh-output-style/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dist": "pnpm run build && pnpm publint",
    "prepublishOnly": "pnpm run dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "output-style",
    "response-style",
    "conversation-mode",
    "prompt",
    "llm",
    "ui"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-session-projection": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.7",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@types/react": "^18.3.31",
    "clsx": "^2.1.1",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.80.0",
    "publint": "^0.3.24",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.24.0"
}
